{
  "Jwt": {
    "Issuer": "QuickCommerce",
    "Audience": "QuickCommerce.Api",
    "SigningKey": ""
  },
  "Pricing": {
    "DeliveryFee": 25,
    "HandlingFee": 5,
    "FreeDeliveryThreshold": 199
  },
  "Payments": {
    "Enabled": false,
    "KeyId": "",
    "KeySecret": "",
    "WebhookSecret": "",
    "HoldMinutes": 15,
    "ReconcileAfterMinutes": 20,
    "JobIntervalSeconds": 60
  },
  "Addresses": {
    "MaxPerCustomer": 10
  },
  "Account": {
    "CodeLifetimeMinutes": 30,
    "MaxCodeAttempts": 5,
    "MaxCodeRequestsPerHour": 3
  },
  "Registration": {},
  "Email": {
    "Mode": "Smtp",
    "From": "",
    "Host": "",
    "Port": 587,
    "UseSsl": true
  },
  "Proxy": {
    "KnownProxies": []
  },
  "RateLimits": {
    "Auth": {
      "LoginPerMinute": 10,
      "RegisterPerHour": 5,
      "ForgotPasswordPerHour": 5,
      "ResetPasswordPerHour": 10,
      "ChangePasswordPerHour": 10
    }
  },
  "Delivery": {
    "BasePrepMinutes": 8,
    "MinutesPerKm": 2
  },
  "Caching": {
    "RedisConnectionString": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
